<mjml>
  <mj-include path="./partial/header.mjml" />

  <mj-body mj-class="bg--blue-100">
    <mj-wrapper css-class="wrapper" padding="0 40px 40px 40px">
      <mj-include path="./partial/banner.mjml" />
      <mj-section mj-class="bg--white-100" padding="30px 20px 60px 20px">
        <mj-column>
          <!-- Welcome Message -->
          <mj-text>
            <h1>{% blocktrans %}Votre archive est prête{% endblocktrans %}</h1>
          </mj-text>
          <mj-divider border-width="1px" border-style="solid" border-color="#DDDDDD" width="30%" align="left"/>

          <!-- Main Message -->
          <mj-text>{% blocktrans %}Suite à votre demande, vous pouvez télécharger une archive contenant l'ensemble des fichiers de votre espace {{source_label}} <strong>{{workspace_name}}</strong>{% endblocktrans %}</mj-text>
          <mj-text>{% blocktrans %}Ce lien vous amène vers l'outil de migration, où une connexion sera nécessaire pour lancer le téléchargement.{% endblocktrans %}</mj-text>

          <mj-button href="{{download_url}}" background-color="#000091" color="white">
            {% trans "Télécharger l'archive"%}
          </mj-button>

          <mj-include path="./partial/support.mjml" />

          <!-- Signature -->
          <mj-text>
            <p>{% trans "La Suite Numérique" %}</p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-include path="./partial/footer.mjml" />
  </mj-body>

</mjml>

