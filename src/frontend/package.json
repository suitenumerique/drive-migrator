{
  "name": "main",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "APP_MAIN": "yarn workspace app-main",
    "I18N": "yarn workspace packages-i18n",
    "app:dev": "yarn APP_MAIN run dev",
    "app:start": "yarn APP_MAIN run start",
    "app:build": "yarn APP_MAIN run build",
    "app:test": "yarn APP_MAIN run test",
    "ci:build": "yarn APP_MAIN run build:ci",
    "lint": "yarn APP_MAIN run lint && yarn workspace eslint-config-main run lint",
    "lint-fix": "yarn APP_MAIN run lint --fix && yarn workspace eslint-config-main run lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "resolutions": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@gouvfr-lasuite/cunningham-react": "4.4.0",
    "cross-env": "10.1.0",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-aria-components": "1.20.0",
    "typescript": "7.0.2"
  }
}
