{
  "name": "app-main",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "cp .env.development .env.local && cross-env NEXT_PUBLIC_CI=true yarn build",
    "build-theme": "cunningham -g css,ts,scss -o src/cunningham --utility-classes && mv src/cunningham/cunningham-tokens.scss src/cunningham/cunningham-tokens-sass.scss",
    "start": "npx -y serve@latest out",
    "lint": "tsc --noEmit && eslint .",
    "lint:verbose": "cross-env DEBUG=\"eslint:cli-engine,eslint:linter\" eslint .",
    "prettier": "prettier --write .",
    "stylelint": "stylelint \"**/*.css\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@gouvfr-lasuite/cunningham-react": "4.4.0",
    "@gouvfr-lasuite/cunningham-tokens": "^3.1.0",
    "@gouvfr-lasuite/integration": "1.0.3",
    "@gouvfr-lasuite/ui-kit": "^0.28.0",
    "@tanstack/react-query": "5.102.2",
    "crisp-sdk-web": "1.2.0",
    "cross-env": "*",
    "grapesjs-blocks-basic": "1.0.2",
    "i18next": "26.4.0",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "next": "16.2.10",
    "react": "19.1.2",
    "react-aria-components": "1.20.0",
    "react-dom": "19.1.2",
    "react-hook-form": "7.86.0",
    "react-i18next": "17.0.12",
    "react-select": "5.10.2",
    "sass": "1.103.1",
    "styled-components": "6.5.3",
    "yjs": "*",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "10.5.10",
    "@storybook/addon-onboarding": "10.5.10",
    "@storybook/blocks": "8.6.14",
    "@storybook/nextjs": "10.5.10",
    "@storybook/react": "10.5.10",
    "@storybook/test": "8.6.15",
    "@svgr/webpack": "8.1.0",
    "@tanstack/react-query-devtools": "5.102.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/luxon": "3.7.5",
    "@types/node": "*",
    "@types/react": "19.2.18",
    "@types/react-dom": "*",
    "dotenv": "17.4.2",
    "eslint-config": "*",
    "eslint-plugin-storybook": "10.5.10",
    "fetch-mock": "12.6.0",
    "grapesjs": "0.23.5",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "node-fetch": "2.7.0",
    "prettier": "3.9.6",
    "storybook": "8.1.11",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-prettier": "5.0.3",
    "typescript": "*",
    "workbox-webpack-plugin": "7.4.1"
  }
