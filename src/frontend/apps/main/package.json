{
  "name": "app-main",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "cp .env.development .env.local && cross-env NEXT_PUBLIC_CI=true yarn build",
    "build-theme": "cunningham -g css,ts,scss -o src/cunningham --utility-classes && mv src/cunningham/cunningham-tokens.scss src/cunningham/cunningham-tokens-sass.scss",
    "start": "npx -y serve@latest out",
    "lint": "tsc --noEmit && eslint .",
    "lint:verbose": "cross-env DEBUG=\"eslint:cli-engine,eslint:linter\" eslint .",
    "prettier": "prettier --write .",
    "stylelint": "stylelint \"**/*.css\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@gouvfr-lasuite/cunningham-react": "4.3.0",
    "@gouvfr-lasuite/cunningham-tokens": "^3.1.0",
    "@gouvfr-lasuite/integration": "1.0.1",
    "@gouvfr-lasuite/ui-kit": "^0.23.2",
    "@tanstack/react-query": "5.40.1",
    "crisp-sdk-web": "1.0.25",
    "cross-env": "*",
    "grapesjs-blocks-basic": "1.0.2",
    "i18next": "23.11.5",
    "lodash": "4.18.1",
    "luxon": "3.4.4",
    "next": "16.2.10",
    "react": "19.1.2",
    "react-aria-components": "1.16.0",
    "react-dom": "19.1.2",
    "react-hook-form": "7.52.0",
    "react-i18next": "14.1.2",
    "react-select": "5.8.0",
    "sass": "1.101.0",
    "styled-components": "6.4.3",
    "yjs": "*",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "1.6.1",
    "@storybook/addon-essentials": "8.1.11",
    "@storybook/addon-interactions": "8.1.11",
    "@storybook/addon-links": "8.1.11",
    "@storybook/addon-onboarding": "8.1.11",
    "@storybook/blocks": "8.1.11",
    "@storybook/nextjs": "8.1.11",
    "@storybook/react": "8.1.11",
    "@storybook/test": "8.1.11",
    "@svgr/webpack": "8.1.0",
    "@tanstack/react-query-devtools": "5.40.1",
    "@testing-library/dom": "10.1.0",
    "@testing-library/jest-dom": "6.4.5",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.12",
    "@types/lodash": "4.17.5",
    "@types/luxon": "3.4.2",
    "@types/node": "*",
    "@types/react": "19.1.8",
    "@types/react-dom": "*",
    "dotenv": "16.4.5",
    "eslint-config": "*",
    "eslint-plugin-storybook": "0.8.0",
    "fetch-mock": "9.11.0",
    "grapesjs": "0.21.10",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "node-fetch": "2.7.0",
    "prettier": "3.3.1",
    "storybook": "8.1.11",
    "stylelint": "16.6.1",
    "stylelint-config-standard": "36.0.0",
    "stylelint-prettier": "5.0.0",
    "typescript": "*",
    "workbox-webpack-plugin": "7.1.0"
  }
}
