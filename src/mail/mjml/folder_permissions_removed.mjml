<mjml>
  <mj-include path="./partial/header.mjml" />

  <mj-body mj-class="bg--blue-100">
    <mj-wrapper css-class="wrapper" padding="0 40px 40px 40px">
      <mj-include path="./partial/banner.mjml" />
      <mj-section mj-class="bg--white-100" padding="30px 20px 60px 20px">
        <mj-column>
          <mj-text>
            <h1>{{ title }}</h1>
          </mj-text>
          <mj-divider border-width="1px" border-style="solid" border-color="#DDDDDD" width="30%" align="left"/>

          <mj-text>{% blocktrans %}Pendant la migration de l'espace <strong>{{workspace_name}}</strong>, les accès aux dossiers ont été limités à votre compte. Vous seul avez les droits d'accès. Les autres animateurs de l'espace peuvent modifier ces limites.{% endblocktrans %}</mj-text>
          <mj-raw>{% if removed_folders %}</mj-raw>
          <mj-text>{% trans "Les accès limités des dossiers suivants ont été supprimés :" %}</mj-text>
          <mj-raw>{% for folder_name in removed_folders %}</mj-raw>
          <mj-text>{{ folder_name }}</mj-text>
          <mj-raw>{% endfor %}</mj-raw>
          <mj-raw>{% endif %}</mj-raw>

          <mj-include path="./partial/support.mjml" />

          <mj-text>
            <p>{% trans "La Suite Numérique" %}</p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-include path="./partial/footer.mjml" />
  </mj-body>

</mjml>
