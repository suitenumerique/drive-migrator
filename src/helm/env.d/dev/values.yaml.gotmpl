commonEnvVars: &commonEnvVars
  DJANGO_CSRF_TRUSTED_ORIGINS: https://migrator.127.0.0.1.nip.io
  DJANGO_CONFIGURATION: Production
  DJANGO_ALLOWED_HOSTS: "*"
  DJANGO_SECRET_KEY: "e$jwt22zxdq$(!c@s9mxs5&7+jgmki%s(&vu6*x_wv#78=*%u0"
  DJANGO_SETTINGS_MODULE: main.settings
  DJANGO_SUPERUSER_PASSWORD: admin
  DJANGO_EMAIL_HOST: "mailcatcher"
  DJANGO_EMAIL_PORT: 1025
  DJANGO_EMAIL_USE_SSL: False
  OIDC_OP_JWKS_ENDPOINT: https://migrator-keycloak.127.0.0.1.nip.io/realms/docs/protocol/openid-connect/certs
  OIDC_OP_AUTHORIZATION_ENDPOINT: https://migrator-keycloak.127.0.0.1.nip.io/realms/docs/protocol/openid-connect/auth
  OIDC_OP_TOKEN_ENDPOINT: https://migrator-keycloak.127.0.0.1.nip.io/realms/docs/protocol/openid-connect/token
  OIDC_OP_USER_ENDPOINT: https://migrator-keycloak.127.0.0.1.nip.io/realms/docs/protocol/openid-connect/userinfo
  OIDC_OP_LOGOUT_ENDPOINT: https://migrator-keycloak.127.0.0.1.nip.io/realms/docs/protocol/openid-connect/logout
  OIDC_REDIRECT_ALLOWED_HOSTS: "migrator.127.0.0.1.nip.io"
  OIDC_AUTH_REQUEST_EXTRA_PARAMS: "{'acr_values': 'eidas1'}"
  OIDC_RP_CLIENT_ID: migrator
  OIDC_RP_CLIENT_SECRET: ThisIsAnExampleKeyForDevPurposeOnly
  OIDC_RP_SIGN_ALGO: RS256
  OIDC_RP_SCOPES: "openid email"
  LOGIN_REDIRECT_URL: https://migrator.127.0.0.1.nip.io
  LOGIN_REDIRECT_URL_FAILURE: https://migrator.127.0.0.1.nip.io
  LOGOUT_REDIRECT_URL: https://migrator.127.0.0.1.nip.io
  DB_HOST: dev-backend-postgres
  DB_NAME:
    secretKeyRef:
      name: dev-backend-postgres
      key: database
  DB_USER:
    secretKeyRef:
      name: dev-backend-postgres
      key: username
  DB_PASSWORD:
    secretKeyRef:
      name: dev-backend-postgres
      key: password
  DB_PORT: 5432
  REDIS_URL: redis://user:pass@dev-backend-redis:6379/1
  DJANGO_CELERY_BROKER_URL: redis://user:pass@dev-backend-redis:6379/1
  AWS_S3_ENDPOINT_URL: http://dev-backend-minio.migrator.svc.cluster.local:9000
  AWS_S3_ACCESS_KEY_ID: dinum
  AWS_S3_SECRET_ACCESS_KEY: password
  AWS_STORAGE_BUCKET_NAME: migrator-media-storage
  STORAGES_STATICFILES_BACKEND: django.contrib.staticfiles.storage.StaticFilesStorage
  APP_EMAIL_FORCE_TO: ToBeDefined

image:
  repository: localhost:5001/backend
  pullPolicy: Always
  tag: "latest"

backend:
  replicas: 1
  envVars:
    <<: *commonEnvVars
  migrate:
    command:
      - "/bin/sh"
      - "-c"
      - |
        python manage.py migrate --no-input &&
        python manage.py create_demo --force
    restartPolicy: Never

  command:
    - "gunicorn"
    - "-c"
    - "/usr/local/etc/gunicorn/main.py"
    - "main.wsgi:application"
    - "--reload"

  createsuperuser:
    command:
      - "/bin/sh"
      - "-c"
      - |
        python manage.py createsuperuser --email admin@example.com --password admin
    restartPolicy: Never

frontend:
  envVars:
    PORT: 8080
    NEXT_PUBLIC_API_ORIGIN: https://migrator.127.0.0.1.nip.io
    NEXT_PUBLIC_SIGNALING_URL: wss://migrator.127.0.0.1.nip.io/ws

  replicas: 1

  image:
    repository: localhost:5001/frontend
    pullPolicy: Always
    tag: "latest"

ingress:
  enabled: true
  host: migrator.127.0.0.1.nip.io

ingressAdmin:
  enabled: true
  host: migrator.127.0.0.1.nip.io

celery:
  replicas: 1
  envVars:
    <<: *commonEnvVars
  image:
    repository: localhost:5001/backend
    pullPolicy: Always
    tag: "latest"

